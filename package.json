{
  "name": "dsh-hard-delete",
  "version": "0.1.0",
  "type": "module",
  "description": "DSH 会话管理：侧边栏会话「…」菜单里一键【彻底删除】会话（不可恢复，不走回收站）",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node _test/test-host.mjs",
    "test:all": "node _test/test-host.mjs && node _test/test-client.mjs",
    "smoke": "node _test/smoke-real-readonly.mjs",
    "e2e": "node _test/verify-e2e-copy.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis-plugin",
    "session",
    "session-management",
    "delete",
    "hard-delete",
    "sidebar-menu",
    "irreversible"
  ],
  "license": "AGPL-3.0-only",
  "author": "qwe4888789",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qwe4888789/dsh-hard-delete.git"
  },
  "homepage": "https://github.com/qwe4888789/dsh-hard-delete#readme",
  "bugs": {
    "url": "https://github.com/qwe4888789/dsh-hard-delete/issues"
  },
  "disclosure": {
    "cloud": false,
    "network": [],
    "offlineMode": true,
    "apiKeys": [],
    "permissions": {
      "network": "仅监听本机回环（HTTP 路由 /api/dsh-hard-delete/*），不主动外联、不发任何数据",
      "filesystem": "读：DSH_HOME 下的 sessions/ 与 storages/；写：删除会话目录、清理 projcache 与 workspace.json 里的引用",
      "env": "只读 DSH_HOME / HARD_DELETE_CONFIG / HARD_DELETE_API_PREFIX"
    },
    "jurisdiction": [],
    "retention": "none"
  }
}
